# PASO 1: Compilar la aplicación usando Maven y Java 21 (Corregido)
FROM maven:3.9.6-eclipse-temurin-21-jammy AS build
WORKDIR /app

# Copiar archivos de configuración y código fuente
COPY pom.xml .
COPY src ./src

# Compilar omitiendo pruebas para no agotar la RAM de Render
RUN mvn clean package -DskipTests


# PASO 2: Crear la imagen de ejecución ligera con Java 21 JRE (Corregido)
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

# Copiar el archivo JAR generado manteniendo tu nombre exacto
COPY --from=build /app/target/aplication-0.0.1-SNAPSHOT.jar app.jar

# Exponer el puerto de Render
EXPOSE 8080

# Ejecutar Spring Boot optimizando el uso de memoria RAM
ENTRYPOINT ["java", "-jar", "app.jar"]
